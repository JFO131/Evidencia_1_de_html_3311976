---
// Dfinamos las propidades
// que pude recibir el componente
interface Props {
    etiqueta: string;
    
    }

    //crear una variable
    //para recibir la etiqueta
    //Astro.probs=los valores desde el control
    const { etiqueta } =Astro.props;
    
---

<!---
Etiqueta input:
se utiliza para los siguientes
controles:
- campo de texto
-password
-checkbox
-radio button
-voton fe envio
ES ETIQUETA CERRADA
--->
<label>{ etiqueta }:</label>
<input type="text" />
<style>

    /*Solo se puede poner aqui*/
    /* sintaxis css*/
    /*Estilos para imput tex*/
    /*Selector de etiqueta:*/
    /* estilos aplicados a toda etiqueta*/
    /*señalado por el selector */
    input[type="text"]{
        background-color:rgb(160, 216, 248);
        width: 400px;
        height: 18px;
        color: rgb(255, 0, 0);
        /*bordes:
        - color
        - peso (grosor)
        - estilo (tipo de linea)
        */
        border-color: rgb(74, 128, 39);
        border-width: 3px;
        border-style: solid;
        border-radius: 10px;
    }

</style>